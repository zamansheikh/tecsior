# =============================================================
# Programmer Nexus — backend environment template
# Copy to `.env` and fill in the blanks.
# =============================================================

# --- HTTP server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB=programmer_nexus

# --- Admin account (seeded on first boot) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Resend (optional — emails on new inquiry) ---
RESEND_API_KEY=
CONTACT_EMAIL=
FROM_EMAIL=Programmer Nexus <hello@programmernexus.com>
